# Configure ONLY on VPS, never commit a real .env.
# Deploy the bound Google Apps Script Web App first (execute as Me; access Anyone).
APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# Run "openssl rand -hex 32" and put the result in both VPS .env and
# Apps Script > Project Settings > Script Properties > BRIDGE_SECRET.
APPS_SCRIPT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
NPM_NETWORK=REPLACE_WITH_YOUR_NPM_DOCKER_NETWORK
TRUSTED_ORIGIN=https://wishes.aadtechgroup.com
